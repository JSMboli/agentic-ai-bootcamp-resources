# Agentic AI Bootcamp provider configuration
# Copy this file to resources/.env and enter only the keys you intend to use.
# NEVER commit or distribute resources/.env.

# -----------------------------------------------------------------------------
# Ollama — local/free route (recommended no-cost classroom fallback)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=15m

# -----------------------------------------------------------------------------
# Groq — recommended hosted route for fast inference and native tool calling
# -----------------------------------------------------------------------------
GROQ_API_KEY=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
GROQ_MODEL=qwen/qwen3.6-27b
# hidden = final answer only; parsed = reasoning separated; raw = <think> in content
GROQ_REASONING_FORMAT=hidden
GROQ_REASONING_EFFORT=none

# -----------------------------------------------------------------------------
# Optional extension providers
# These model defaults were refreshed for the August 2026 bootcamp. Provider
# catalogues change, so students should use each provider's model-list/docs if
# an account exposes a different model set.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Automatic classroom routing. Explicit provider=... never silently falls back.
AUTO_PROVIDER_ORDER=groq,ollama,openai,gemini,anthropic,deepseek,mimic
